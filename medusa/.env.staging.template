# Security Configuration - Staging Environment Variables
#
# CORS Configuration for Session 4A Security Implementation

# Admin CORS Origins (staging domains)
ADMIN_CORS=https://admin-staging.yourdomain.com,http://localhost:9000

# Store CORS Origins (staging domains + local dev)
STORE_CORS=https://store-staging.yourdomain.com,https://fabric-store-staging.yourdomain.com,http://localhost:3000,http://localhost:3006

# Stripe Webhook Origins
STRIPE_WEBHOOK_ORIGINS=https://stripe.com

# Environment
NODE_ENV=staging

# Database and other staging config...
DATABASE_URL=your_staging_database_url