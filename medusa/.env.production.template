# Security Configuration - Production Environment Variables
#
# CORS Configuration for Session 4A Security Implementation
# Replace with your actual production domains

# Admin CORS Origins (comma-separated, no trailing slashes)
# Example: https://admin.yourdomain.com,https://admin-staging.yourdomain.com
ADMIN_CORS=https://admin.yourdomain.com

# Store CORS Origins (comma-separated, no trailing slashes)
# Include all frontend apps that need API access
# Example: https://store.yourdomain.com,https://fabric-store.yourdomain.com
STORE_CORS=https://store.yourdomain.com,https://fabric-store.yourdomain.com

# Stripe Webhook Origins (optional - for additional validation)
# Stripe sends webhooks from various IPs, so this is typically not restrictive
STRIPE_WEBHOOK_ORIGINS=https://stripe.com

# Security Headers Configuration
NODE_ENV=production

# Database and other existing config...
DATABASE_URL=your_production_database_url
POSTGRES_URL=your_production_postgres_url