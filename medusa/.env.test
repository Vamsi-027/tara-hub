# ============================================
# Security (Test Values)
# ============================================
JWT_SECRET=test_jwt_secret_for_e2e_testing
COOKIE_SECRET=test_cookie_secret_for_e2e_testing

# ============================================
# CORS Configuration (Test)
# ============================================
STORE_CORS=http://localhost:3000,http://localhost:3006,http://localhost:3007,http://localhost:8000
